# Copy to .env and change the secrets before running anywhere but your own machine.
# docker compose reads .env automatically.

# Shared by every service: signs the session cookie (at least 32 characters)
FSN_JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# PostgreSQL superuser (only used to create the application role) and the application role
POSTGRES_PASSWORD=change-me-postgres
FSN_DB_PASSWORD=change-me-fsn-user

# Basic auth between the services and config-server
CONFIG_SERVER_PASSWORD=change-me-config

# Session cookie over plain HTTP (http://localhost or a LAN address for testing on phones).
# Set to true when the site is served over HTTPS.
FSN_COOKIE_SECURE=false

# Zone the 1.x services ran in; only used when upgrading a 1.x database
FSN_LEGACY_TIME_ZONE=Asia/Kolkata

# Shown on the password help page
FSN_SUPPORT_CONTACT=your branch office
